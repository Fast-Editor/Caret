{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caret",
  "version": "0.1.0",
  "identifier": "dev.caret.editor",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Caret",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#161618",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "publisher": "Fast Editor",
    "homepage": "https://github.com/Fast-Editor/Caret",
    "shortDescription": "Cursor-class local AI coding agent",
    "longDescription": "Caret is a memory-efficient, Rust-powered AI code editor: a Cursor-class agent, Verified Diff, sandboxed commands, semantic terminal, external agents via ACP and an Auto router."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Fast-Editor/Caret/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMkQwOERFNjcwRDIyRDQKUldUVUlnMW4zZ2d0RytaOFZjbXJ0SkFOR2k1SHo3OWt0b3VHV3ZONzF4Zm9QQTdJTmhrUXZpR1gK"
    }
  }
}

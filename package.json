{
  "name": "caret",
  "productName": "Caret",
  "version": "0.1.0",
  "description": "Caret — a memory-efficient, Rust-powered AI code editor (Tauri + Monaco)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",

{
  "version": "0.1.0",
  "description": "A Cursor-class AI code editor with a Rust core. No bundled Chromium, no Node at run time.",
  "homepage": "https://github.com/Fast-Editor/Caret",
  "license": "MIT",
  "notes": [
    "The installer is unsigned until a Windows certificate is configured, so SmartScreen may ask once.",
    "Caret can update itself from Settings > About; run 'scoop update caret' to keep the scoop manifest in step."
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/Fast-Editor/Caret/releases/download/v0.1.0/Caret_0.1.0_x64-setup.exe",
      "hash": "2e4f5ecdb0a7547d237597f41b39597713ec2b0666a66801cc38ebe27e7632fa"
    }
  },
  "installer": {
    "script": [
      "$setup = Join-Path $dir $fname",
      "Start-Process -Wait -FilePath $setup -ArgumentList @('/S', \"/D=$dir\\app\")",
      "Remove-Item $setup"
    ]
  },
  "uninstaller": {
    "script": "Start-Process -Wait -FilePath \"$dir\\app\\uninstall.exe\" -ArgumentList @('/S')"
  },
  "bin": "app\\Caret.exe",
  "shortcuts": [
    ["app\\Caret.exe", "Caret"]
  ],
  "checkver": {
    "github": "https://github.com/Fast-Editor/Caret"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Fast-Editor/Caret/releases/download/v$version/Caret_$version_x64-setup.exe"
      }
    },
    "hash": {
      "url": "https://github.com/Fast-Editor/Caret/releases/download/v$version/SHA256SUMS.txt"
    }
  }
}
